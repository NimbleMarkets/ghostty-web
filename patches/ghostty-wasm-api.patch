+    /// Browser registry objects are tightly packed, with no POSIX page padding.
+    /// This hook consumes whole objects; non-zero offsets are unsupported.
+    fn readSharedMemoryHook(
+        self: *LoadingImage,
+        alloc: Allocator,
+        t: command.Transmission,
+        name: []const u8,
+    ) !void {
+        const read = sys.read_shared_memory orelse return error.UnsupportedMedium;
+        const bytes = try read(alloc, name);
+        defer alloc.free(bytes);
+        if (t.offset != 0) return error.InvalidData;
+        const expected_size: usize = if (t.size > 0) @intCast(t.size) else switch (self.image.format) {
+            .png => bytes.len,
+            .gray, .gray_alpha, .rgb, .rgba => size: {
+                const pixels = std.math.mul(usize, self.image.width, self.image.height) catch
+                    return error.InvalidData;
+                break :size std.math.mul(usize, pixels, command.Transmission.formatBpp(self.image.format)) catch
+                    return error.InvalidData;
+            },
+        };
+        if (expected_size == 0 or expected_size > max_size or bytes.len != expected_size)
+            return error.InvalidData;
+        try self.data.appendSlice(alloc, bytes);
